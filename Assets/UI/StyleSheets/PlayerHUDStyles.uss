.electricity-bar .unity-progress-bar__container {
    height: auto;
    min-height: 100%;
    background-color: rgb(0, 0, 0);
}

.electricity-bar .unity-progress-bar__progress {
    background-color: rgb(255, 226, 0);
}

.electricity-bar .unity-progress-bar__background {
    background-color: rgb(0, 0, 0);
}