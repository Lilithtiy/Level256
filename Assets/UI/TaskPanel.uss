.fill { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

/* prompt + hold bar */
.prompt { position: absolute; left: 0; right: 0; bottom: 18%; align-items: center; display: none; }
.prompt__text { color: white; font-size: 24px; padding: 8px 20px; background-color: rgba(0,0,0,0.6); border-radius: 4px; }
.hold { position: absolute; left: 50%; bottom: 12%; width: 360px; margin-left: -180px; display: none; }
.hold__label { color: white; font-size: 20px; -unity-text-align: middle-center; margin-bottom: 4px; }
.hold__track { height: 12px; background-color: rgba(255,255,255,0.15); border-radius: 6px; overflow: hidden; }
.hold__fill { height: 100%; width: 0; background-color: #FFEB04; }

/* panel frame */
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.55);
           align-items: center; justify-content: center; display: none; }
.panel { min-width: 600px; padding: 28px 40px; background-color: rgb(14,14,18);
         border-width: 2px; border-color: #FFEB04; border-radius: 6px; }
.panel-title { color: #FFEB04; font-size: 36px; -unity-font-style: bold-and-italic; -unity-text-align: middle-center; margin-bottom: 14px; }
.panel-instruction { color: rgba(255,255,255,0.85); font-size: 22px; -unity-text-align: middle-center; margin: 6px 0; white-space: normal; }
.panel-role { color: #FFEB04; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; }
.panel-note { color: rgba(255,255,255,0.55); font-size: 18px; -unity-text-align: middle-center; margin: 4px 0; }
.panel-status { min-height: 32px; margin-top: 14px; font-size: 22px; color: rgba(255,255,255,0.7); -unity-text-align: middle-center; }
.panel-status--good { color: rgb(90,255,120); }
.panel-status--bad { color: rgb(255,100,90); }
.panel-hint { color: rgba(255,255,255,0.35); font-size: 14px; -unity-text-align: middle-center; margin-top: 10px; }

.row { flex-direction: row; justify-content: center; flex-wrap: wrap; margin: 10px 0; }
.section { display: none; }

/* shared controls */
.switch, .key, .lever, .pad { border-width: 0; color: white; -unity-font-style: bold; }

/* breaker */
.lamp { width: 56px; height: 24px; margin: 0 6px; background-color: rgb(70,20,20); border-radius: 3px; }
.lamp--on { background-color: rgb(60,255,90); }
.switch { width: 76px; height: 70px; margin: 0 6px; font-size: 20px; background-color: rgb(120,35,35); border-radius: 4px; }
.switch:hover { background-color: rgb(150,50,50); }
.switch--on { background-color: rgb(40,170,70); }
.switch--on:hover { background-color: rgb(55,195,90); }

/* keypad */
.keypad { flex-direction: row; flex-wrap: wrap; width: 276px; align-self: center; }
.key { width: 80px; height: 52px; margin: 4px; font-size: 24px; background-color: rgb(36,36,44); border-radius: 4px; }
.key:hover { background-color: rgb(64,64,78); }
.display { color: white; font-size: 46px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 8px 0; }

/* levers */
.lever { width: 96px; height: 120px; margin: 0 8px; font-size: 28px; background-color: rgb(50,50,60); border-radius: 6px; }
.lever:hover { background-color: rgb(75,75,90); }
.lever--pulled { background-color: rgb(40,170,70); }

/* colour pads (for the memory and decoder) */
.pad { width: 110px; height: 110px; margin: 8px; border-radius: 10px; opacity: 0.55; }
.pad:hover { opacity: 0.8; }
.pad--lit { opacity: 1; scale: 1.08 1.08; }
.c0 { background-color: rgb(230,60,60); }
.c1 { background-color: rgb(70,110,255); }
.c2 { background-color: rgb(60,200,90); }
.c3 { background-color: rgb(245,210,40); }
.t0 { color: rgb(255,110,110); }
.t1 { color: rgb(120,160,255); }
.t2 { color: rgb(90,230,120); }
.t3 { color: rgb(250,220,70); }
.token { color: white; font-size: 24px; -unity-font-style: bold; padding: 6px 14px; margin: 4px; background-color: rgb(36,36,44); border-radius: 4px; }

/* objective HUD */
.hud { position: absolute; top: 24px; right: 28px; width: 360px; }
.hud__title { color: #FFEB04; font-size: 16px; -unity-font-style: bold; margin-bottom: 6px; -unity-text-align: middle-right; }
.hud__row { flex-direction: row; justify-content: space-between; padding: 3px 8px; margin-bottom: 2px; background-color: rgba(0,0,0,0.45); }
.hud__name, .hud__value { color: white; font-size: 17px; }
.hud__value { color: rgba(255,255,255,0.7); }
.hud__row--done .hud__name, .hud__row--done .hud__value { color: rgb(90,255,120); }
.hud__lives { color: white; font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-right; margin-top: 8px; }

/* memory console pads */
.simon {
    opacity: 1;
    border-width: 4px;
    border-color: rgba(255,255,255,0.08);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.08s;
}

.simon.c0 { background-color: rgb(105,30,30); }
.simon.c1 { background-color: rgb(30,45,115); }
.simon.c2 { background-color: rgb(25,90,40); }
.simon.c3 { background-color: rgb(110,90,15); }

/* a little feedback when you hover a pad on your turn */
.simon.c0:hover { background-color: rgb(140,42,42); }
.simon.c1:hover { background-color: rgb(42,62,150); }
.simon.c2:hover { background-color: rgb(36,120,56); }
.simon.c3:hover { background-color: rgb(145,120,22); }

/* lit: bright colour, white outline, slightly bigger */
.simon.pad--lit { border-color: white; scale: 1.12 1.12; }
.simon.pad--lit.c0 { background-color: rgb(255,80,80); }
.simon.pad--lit.c1 { background-color: rgb(90,140,255); }
.simon.pad--lit.c2 { background-color: rgb(80,255,120); }
.simon.pad--lit.c3 { background-color: rgb(255,232,60); }

/* wire matching */
.c4 { background-color: rgb(170,80,230); }

.wire-board { flex-direction: row; justify-content: space-between; width: 440px; align-self: center; margin: 10px 0; }
.wire-col { flex-direction: column; }
.wire-node { width: 56px; height: 56px; margin: 8px 0; border-width: 4px; border-color: rgba(255,255,255,0.15); border-radius: 28px; }
.wire-node:hover { border-color: rgba(255,255,255,0.6); }
.wire-node--selected { border-color: white; scale: 1.15 1.15; }
.wire-node--done { border-color: rgba(255,255,255,0.35); }
.wire-node--wrong { border-color: rgb(255,70,60); }


.lamp { -unity-text-align: middle-center; font-size: 14px; -unity-font-style: bold; color: rgba(255,255,255,0.9); }

/* relay */
.relay-number { color: #FFEB04; font-size: 72px; -unity-font-style: bold; -unity-text-align: middle-center; margin: 16px 0; }